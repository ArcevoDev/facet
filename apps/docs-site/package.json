{
  "name": "@arcevo/facet-story",
  "version": "0.1.0",
  "description": "facet-story: Storybook-style component gallery and documentation for the Arcevo ecosystem. Inline component previews, per-component variant pages, install tabs, and an optional ecosystem links section. Ships a built demo plus the customization source (nav config, previews, pages) for forking.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build -o storybook-static"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcevoDev/facet.git",
    "directory": "apps/docs-site"
  },
  "bugs": {
    "url": "https://github.com/ArcevoDev/facet/issues"
  },
  "homepage": "https://story.facet.arcevocirqle.com.ng",
  "license": "MIT",
  "keywords": [
    "docs",
    "documentation",
    "storybook",
    "component-library",
    "arcevocirqle",
    "facet"
  ],
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.1.1",
    "lucide-react": "^0.468.0",
    "@arcevo/facet-tokens": "workspace:*",
    "@arcevo/facet-components": "workspace:*",
    "@arcevo/facet-layout": "workspace:*",
    "@arcevo/facet-auth": "workspace:*",
    "@arcevo/facet-sdk": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-themes": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sonner": "^2.0.7",
    "storybook": "^10.5.5",
    "typescript": "^5",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
