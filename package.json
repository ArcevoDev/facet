{
  "name": "facet",
  "version": "0.1.0",
  "private": true,
  "description": "Domain-customizable auth-first component system for the Arcevo ecosystem",
  "type": "module",
  "scripts": {
    "build": "pnpm build:tokens && pnpm -r build && pnpm build:docs",
    "build:tokens": "pnpm -F @arcevo/facet-tokens build",
    "build:components": "pnpm -F @arcevo/facet-components build",
    "build:sdk": "pnpm -F @arcevo/facet-sdk build",
    "release": "pnpm build && pnpm changeset publish",
    "dev:landing": "pnpm -F @arcevo/facet-landing dev",
    "dev:docs": "pnpm -F @arcevo/facet-docs dev",
    "dev:docs-site": "pnpm -F @arcevo/facet-story dev",
    "build:docs": "pnpm -F @arcevo/facet-docs build",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "check:docs": "node scripts/check-docs-inventory.mjs",
    "build:turbo": "turbo run build",
    "test:turbo": "turbo run test",
    "typecheck:turbo": "turbo run typecheck",
    "lint:turbo": "turbo run lint",
    "analyze": "pnpm -r run build:analyze && pnpm analyze:apps",
    "analyze:apps": "pnpm --filter @arcevo/facet-landing analyze",
    "nuke": "pnpm clean --lockfile"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "^10.5.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "turbo": "^2.10.7",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.17.0"
}
