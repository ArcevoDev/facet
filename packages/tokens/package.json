{
  "name": "@arcevo/facet-tokens",
  "version": "1.1.1",
  "description": "Design tokens for the ArcevoCirqle ecosystem: Alpha Palette colors, typography, spacing, and sub-brand accents in OKLCH",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node -e \"require('fs').cpSync('src/tokens.css', 'dist/tokens.css'); require('fs').cpSync('src/tailwind.css', 'dist/tailwind.css')\"",
    "build:analyze": "tsup src/index.ts --format esm --dts --metafile",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcevoDev/facet.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/ArcevoDev/facet/issues"
  },
  "homepage": "https://facet.arcevocirqle.com.ng",
  "license": "MIT",
  "keywords": [
    "design-tokens",
    "alpha-palette",
    "arcevocirqle",
    "ui",
    "oklch"
  ],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "dependencies": {
    "tw-animate-css": "^1.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
